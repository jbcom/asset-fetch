{
  "name": "@jbdevprimary/asset-fetch",
  "version": "0.1.1",
  "description": "Typed CLI and library for finding, verifying, extracting, and curating game assets from itch.io, Poly Haven, and local SQLite catalogs.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "bin": {
    "asset-fetch": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify",
    "pack:check": "pnpm pack --dry-run",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run pack:check"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/asset-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/asset-fetch/issues"
  },
  "homepage": "https://github.com/jbcom/asset-fetch#readme",
  "packageManager": "pnpm@11.23.0",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "keywords": [
    "assets",
    "asset-pipeline",
    "itch.io",
    "poly-haven",
    "sqlite",
    "3d-assets",
    "cli",
    "game-dev"
  ]
}
