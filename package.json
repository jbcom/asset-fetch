{
  "name": "@jbcom/asset-fetch",
  "version": "0.1.1",
  "description": "CLI-first, multi-backend asset search + fetch toolkit: itch.io owned library (fetch + curated promotion), a local SQLite asset catalog, and Polyhaven public HDRI/texture/model catalog. TypeScript, no MCP required — designed to run from game scripts and CI.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "asset-fetch": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/asset-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/asset-fetch/issues"
  },
  "homepage": "https://github.com/jbcom/asset-fetch#readme",
  "packageManager": "pnpm@11.23.0",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "keywords": [
    "assets",
    "asset-pipeline",
    "itch.io",
    "polyhaven",
    "cli",
    "game-dev",
    "hdri",
    "sqlite"
  ]
}
